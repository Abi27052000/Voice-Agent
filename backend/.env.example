# Copy to backend/.env and fill in. Never commit .env.

# Vapi dashboard > Organization > API Keys (https://dashboard.vapi.ai/org/api-keys)
# PRIVATE key: server-side only.
VAPI_API_KEY=
# PUBLIC key: safe to expose to the browser (used for web calls).
VAPI_PUBLIC_KEY=

# Any long random string. Vapi will send it as "Authorization: Bearer <secret>"
# to our webhook (configured as a Custom Credential in Step 3).
VAPI_WEBHOOK_SECRET=

# Public HTTPS URL that tunnels to this backend, e.g. https://your-name.ngrok-free.app
PUBLIC_BASE_URL=

# Optional overrides
# DATABASE_URL=sqlite:///./data/app.db
# CORS_ORIGINS=["http://localhost:5173"]

# --- Hosted demo only (Cloud Run). Leave these OFF locally. ---
# Generated for you by: uv run python -m scripts.cloud_run_env --frontend https://<site>.web.app
# (writes data/deploy/cloud-run.env.yaml for gcloud and cloud-run.env.console.txt for the console)
# PUBLIC_DEMO=true          # open dashboard APIs on purpose + show "fictional data" banner
# SEED_DEMO_DATA=true       # seed fictional demo data when the database is empty
# VAPI_IDS_JSON={...}       # contents of vapi/ids.json (not uploaded to the container)
# CORS_ORIGINS=["https://<site>.web.app","https://<site>.firebaseapp.com"]
